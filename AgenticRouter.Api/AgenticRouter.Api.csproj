<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.11.0-alpha</Version>
    <AssemblyVersion>0.11.0.0</AssemblyVersion>
    <FileVersion>0.11.0.0</FileVersion>
    <InformationalVersion>0.11.0_alpha</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="data\**\*" />
    <None Remove="data\**\*" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.973" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Markdown.ColorCode" Version="3.0.1" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Setup\Scripts\install-ollama-linux.sh"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="scripts\install-ollama-linux.sh" />
    <None Update="Setup\Scripts\switch-ollama-linux-profile.sh"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="scripts\switch-ollama-linux-profile.sh" />
  </ItemGroup>

</Project>
